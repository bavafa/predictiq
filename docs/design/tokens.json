{
  "$description": "PredictIQ design tokens (proposed, design stage, 2026-11-13). Light data surfaces only. Contrast ratios are in tokens.md and are recomputed by check-contrast.py from this file.",
  "color": {
    "sidebar": {
      "bg": "#2B3843",
      "bg-active": "#425563",
      "text": "#F2F4F5",
      "text-muted": "#B7C1C9",
      "text-active": "#FFFFFF",
      "focus-ring": "#F5A092"
    },
    "surface": {
      "background": "#f8f8f8",
      "card": "#FFFFFF",
      "subtle": "#EEEEEE",
      "border": "#DBDBDB",
      "input-border": "#767676"
    },
    "text": {
      "primary": "#363636",
      "secondary": "#425563",
      "muted": "#6b7280",
      "on-primary": "#FFFFFF"
    },
    "brand": {
      "primary": "#C8341F",
      "primary-hover": "#A82B1A",
      "link": "#425563",
      "focus-ring": "#E84A37"
    },
    "notice": {
      "disclosure-bg": "#E8ECEF",
      "disclosure-text": "#2B3843",
      "replay-bg": "#FDECEA",
      "replay-text": "#A82B1A"
    },
    "value-type": {
      "historical-bg": "#EEEEEE",
      "historical-text": "#334155",
      "predicted-bg": "#DBEAFE",
      "predicted-text": "#1E40AF",
      "illustrative-bg": "#EDE9FE",
      "illustrative-text": "#5B21B6"
    },
    "risk": {
      "below-bg": "#EEEEEE",
      "below-text": "#334155",
      "alert-bg": "#FEF3C7",
      "alert-text": "#92400E",
      "alert-border": "#B45309",
      "recorded-failure": "#B91C1C",
      "recorded-failure-bg": "#FEE2E2",
      "recorded-failure-text": "#991B1B"
    },
    "feedback": {
      "problem-text": "#92400E",
      "problem-border": "#B45309"
    },
    "chart": {
      "surface": "#FFFFFF",
      "sensor-line": "#425563",
      "risk-line": "#E84A37",
      "model-main": "#E84A37",
      "model-baseline": "#7C3AED",
      "cutoff-line": "#B45309",
      "recorded-failure": "#B91C1C",
      "maintenance-marker": "#475569",
      "error-marker": "#6b7280",
      "histogram-bar": "#C8341F",
      "axis": "#6b7280",
      "grid": "#E5E7EB"
    }
  },
  "type": {
    "family": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "numeric": "tabular figures for every number in tables, cards and tooltips",
    "scale": {
      "xs": { "size": 12, "line": 16, "weight": 500 },
      "sm": { "size": 14, "line": 20, "weight": 400 },
      "base": { "size": 16, "line": 24, "weight": 400 },
      "lg": { "size": 18, "line": 28, "weight": 600 },
      "xl": { "size": 22, "line": 28, "weight": 600 },
      "2xl": { "size": 30, "line": 36, "weight": 600 }
    }
  },
  "space": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": { "sm": 4, "md": 6, "lg": 8, "xl": 12, "full": 9999 },
  "layout": {
    "sidebar-width": 240,
    "topbar-height": 56,
    "content-max-width": 1440,
    "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
    "nav-collapses-below": 1024,
    "min-touch-target": 44
  },
  "motion": { "fast-ms": 120, "base-ms": 200, "replay-step-ms": 1000, "reduced-motion": "no chart animation; replay still steps" },
  "contrast-pairs": [
    ["sidebar.text", "sidebar.bg", "text"],
    ["sidebar.text-muted", "sidebar.bg", "text"],
    ["sidebar.text-active", "sidebar.bg-active", "text"],
    ["sidebar.text", "sidebar.bg-active", "text"],
    ["sidebar.text-muted", "sidebar.bg-active", "text", "forbidden"],
    ["sidebar.focus-ring", "sidebar.bg", "ui"],
    ["text.primary", "surface.card", "text"],
    ["text.primary", "surface.background", "text"],
    ["text.primary", "surface.subtle", "text"],
    ["text.secondary", "surface.card", "text"],
    ["text.secondary", "surface.background", "text"],
    ["text.secondary", "surface.subtle", "text"],
    ["text.muted", "surface.card", "text"],
    ["text.muted", "surface.background", "text"],
    ["text.muted", "surface.subtle", "text", "forbidden"],
    ["text.on-primary", "brand.primary", "text"],
    ["text.on-primary", "brand.primary-hover", "text"],
    ["brand.primary", "surface.card", "text"],
    ["brand.primary", "surface.background", "text"],
    ["brand.link", "surface.card", "text"],
    ["brand.link", "surface.background", "text"],
    ["brand.focus-ring", "surface.card", "ui"],
    ["brand.focus-ring", "surface.background", "ui"],
    ["notice.disclosure-text", "notice.disclosure-bg", "text"],
    ["notice.replay-text", "notice.replay-bg", "text"],
    ["value-type.historical-text", "value-type.historical-bg", "text"],
    ["value-type.predicted-text", "value-type.predicted-bg", "text"],
    ["value-type.illustrative-text", "value-type.illustrative-bg", "text"],
    ["risk.below-text", "risk.below-bg", "text"],
    ["risk.alert-text", "risk.alert-bg", "text"],
    ["risk.alert-text", "surface.card", "text"],
    ["risk.alert-border", "surface.card", "ui"],
    ["risk.recorded-failure-text", "risk.recorded-failure-bg", "text"],
    ["text.on-primary", "risk.recorded-failure", "text"],
    ["feedback.problem-text", "surface.card", "text"],
    ["feedback.problem-border", "surface.card", "ui"],
    ["surface.input-border", "surface.card", "ui"],
    ["surface.input-border", "surface.background", "ui"],
    ["surface.input-border", "surface.subtle", "ui"],
    ["surface.border", "surface.card", "ui", "forbidden"],
    ["chart.sensor-line", "chart.surface", "ui"],
    ["chart.risk-line", "chart.surface", "ui"],
    ["chart.model-baseline", "chart.surface", "ui"],
    ["chart.cutoff-line", "chart.surface", "ui"],
    ["chart.recorded-failure", "chart.surface", "ui"],
    ["chart.maintenance-marker", "chart.surface", "ui"],
    ["chart.error-marker", "chart.surface", "ui"],
    ["chart.histogram-bar", "chart.surface", "ui"],
    ["chart.axis", "chart.surface", "text"],
    ["chart.grid", "chart.surface", "ui", "forbidden"],
    ["text.secondary", "risk.alert-bg", "text"],
    ["text.muted", "risk.alert-bg", "text", "forbidden"],
    ["text.muted", "notice.disclosure-bg", "text", "forbidden"],
    ["brand.link", "notice.disclosure-bg", "text"]
  ]
}
