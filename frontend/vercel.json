{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{app/**,node_modules/**,.next/**,e2e/**,tests/**,components/**,lib/**,public/**,playwright-report/**,test-results/**}",
      "includeFiles": "{_backend/app/**,_backend/bundle/**}"
    }
  }
}
